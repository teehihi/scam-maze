{
  "name": "scammaze-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "SCAMMAZE: Browser-based first-person 3D scam investigation simulation game & landing portal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/teehihi/scam-maze.git"
  },
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm dev:landing",
    "dev:landing": "pnpm --filter @scammaze/landing dev",
    "dev:game": "pnpm --filter @scammaze/game dev",
    "build:landing": "pnpm --filter @scammaze/landing build",
    "build:game": "pnpm --filter @scammaze/game build",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5"
  }
}
